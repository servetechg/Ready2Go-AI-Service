# ---------------------------------------------------------------------------
# Ready2Go AI Service — environment template.
# Copy to `.env` and fill in real values. NEVER commit a real .env.
# ---------------------------------------------------------------------------

# Runtime
ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
RELOAD=true
REQUEST_TIMEOUT_S=25

# Auth (shared with the Next.js app)
PYTHON_INTEGRITY_TOKEN=change-me-long-random-token
HMAC_SECRET=

# OpenAI
OPENAI_API_KEY=
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_SUMMARY_MODEL=gpt-4o-mini

# Weaviate (vector store)
WEAVIATE_URL=
WEAVIATE_API_KEY=

# ---------------------------------------------------------------------------
# MongoDB — ONE database (MONGODB_DB, default ready2go), TWO disjoint uses:
#   1. Python's OWN request-path state lives in dedicated `ai_*` COLLECTIONS in
#      this DB: ai_analysis_cache / ai_audit_state / ai_call_log. Next.js never
#      reads them; Python never writes the app's domain docs.
#   2. The offline prep/seed scripts (scripts/prep/*) read/write the app's
#      tenant-aware collections. Point at a DEV/STAGING cluster for those; NEVER
#      the production URI. Read-only user for Phase-B prepare.py; seed_mongo.py
#      needs write.
# Local dev (docker-compose) sets MONGODB_URI=mongodb://mongo:27017 for you.
# ---------------------------------------------------------------------------
MONGODB_URI=
MONGODB_DB=ready2go

# ---------------------------------------------------------------------------
# Cloudinary — optional, only used when SEED_USE_CLOUDINARY=true.
# Same account as the Next.js app so seed fileUrls match production shape.
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=earthquick/emergency-plans

# ---------------------------------------------------------------------------
# Seed control — building the removable .gov test corpus in MongoDB.
# SEED_OWNER_IDS: comma-separated REAL subadmin User._id hex strings so the
#   seeded docs appear in the UI when you log in as those subadmins.
#   Leave blank to fall back to reserved synthetic ids (won't be loginnable).
# SEED_USE_CLOUDINARY: true = upload PDFs to Cloudinary; false = store .gov URL.
# SEED_MARK: marker stamped on every seed artifact; cleanup.py deletes by it.
# ---------------------------------------------------------------------------
SEED_OWNER_IDS=
SEED_USE_CLOUDINARY=false
SEED_MARK=gov-coop-bcp-2026

# Model / scoring
MODEL_VERSION=integrity-v1
MAX_CHUNKS_PER_DOC=200
AUDIT_SAMPLE_CAP=25
WEIGHT_CONTENT=0.40
WEIGHT_NAME=0.15
WEIGHT_CATEGORY=0.20
WEIGHT_QUALITY=0.15
WEIGHT_DUPLICATION=0.10
BAND_IN_SYNC=71
BAND_REVIEWING=41
LLM_JUDGE_BAND=60,72
